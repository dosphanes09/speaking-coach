# Public mobile build configuration. Do not put API keys or secrets here.
# EAS production builds receive these values from the EAS production environment.
# Local development can leave these empty and use Settings > Backend API URL.
# Set this to the Render HTTPS origin, without /health, /api, or a trailing slash.
EXPO_PUBLIC_API_URL=
# Legacy aliases retained only for existing development configurations.
EXPO_PUBLIC_BACKEND_API_URL=
EXPO_PUBLIC_BACKEND_BASE_URL=
# Optional additional origins. EXPO_PUBLIC_API_URL is automatically allowed.
EXPO_PUBLIC_ALLOWED_BACKEND_ORIGINS=
