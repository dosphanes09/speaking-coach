{
  "name": "daily-speaking-coach",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:lan": "expo start --clear --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:apk": "node scripts/check-apk.mjs",
    "typecheck": "tsc --noEmit",
    "test:logic": "npm run test:scoreUtils && npm run test:streak && npm run test:recordClassification && npm run test:analysisEnrichment && npm run test:practiceTiming && npm run test:beforeAfter && npm run test:dailyLesson",
    "test:scoreUtils": "tsx scripts/scoreUtilsSelfTest.ts",
    "test:streak": "tsx scripts/streakServiceSelfTest.ts",
    "test:recordClassification": "tsx scripts/recordClassificationSelfTest.ts",
    "test:analysisEnrichment": "tsx scripts/analysisEnrichmentSelfTest.ts",
    "test:practiceTiming": "tsx scripts/practiceTimingSelfTest.ts",
    "test:beforeAfter": "tsx scripts/beforeAfterServiceSelfTest.ts",
    "test:dailyLesson": "tsx scripts/dailyLessonSelfTest.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2",
    "tsx": "^4.19.0"
  }
}
