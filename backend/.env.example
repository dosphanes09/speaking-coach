OPENAI_API_KEY=
PORT=3001
NODE_ENV=development
SERVICE_NAME=daily-speaking-coach-api

# Comma-separated browser origins. Native mobile requests usually have no Origin header.
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
REQUIRE_HTTPS=false
REQUIRE_APP_AUTH=false

# Production authentication and persistent quota storage.
# Generate AUTH_TOKEN_SECRET and APP_INVITE_CODES with: npm run generate:security-secrets -- 3
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=31536000
AUTH_ISSUER=daily-speaking-coach-api
AUTH_AUDIENCE=daily-speaking-coach-mobile
APP_INVITE_CODES=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAX_FILE_SIZE_BYTES=12582912
MAX_AUDIO_DURATION_SECONDS=120
MAX_DAILY_ANALYSES_PER_USER=10
MAX_DAILY_CHAT_MESSAGES_PER_USER=60
MAX_CHAT_MESSAGE_LENGTH=1200
MAX_CHAT_HISTORY_MESSAGES=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_CHAT_MAX_OUTPUT_TOKENS=700

# Direct audio analysis: the model listens to the recording itself instead of only the
# transcript (pronunciation/intonation/hesitation judged from the actual audio). Requires
# ffmpeg-static (added to package.json) to normalize recordings to WAV before sending them.
# Set to false to force the previous transcript-only analysis path (e.g. if this needs to be
# disabled quickly in production without a redeploy).
ENABLE_AUDIO_ANALYSIS=true
OPENAI_AUDIO_ANALYSIS_MODEL=gpt-audio
