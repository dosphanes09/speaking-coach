{
  "expo": {
    "name": "Daily Speaking Coach",
    "slug": "daily-speaking-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F7F2"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Daily Speaking Coach uses the camera when you choose video practice.",
          "microphonePermission": "Daily Speaking Coach records your one-minute speaking practice.",
          "recordAudioAndroid": true
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Daily Speaking Coach uses the camera when you choose video practice.",
        "NSMicrophoneUsageDescription": "Daily Speaking Coach records your one-minute speaking practice."
      }
    },
    "android": {
      "package": "com.yagiz.dailyspeakingcoach",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "46dada26-4a1e-4c13-8dd9-c49b68bd9ceb"
      }
    },
    "owner": "dosphanes"
  }
}
